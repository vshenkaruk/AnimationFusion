  "script": [
    {
      "beat": "Hook",
      "text": "Thirty seconds. Find the missing kitten."
    },
    {
      "beat": "Choose a route",
      "text": "Choose A: Candy Canyon. Or B: the Clockwork Sea."
    },
    {
      "beat": "Choice and consequence",
      "text": "Nia picks A and sprints across the bridge. A sugar wave snaps it, and the river carries them to the harbor."
    },
    {
      "beat": "Find the clue",
      "text": "A blue pin blinks beneath the pier."
    },
    {
      "beat": "Dive and grab",
      "text": "Thomas dives, grabs it, and clips it onto the map."
    },
    {
      "beat": "Payoff",
      "text": "The map opens a gold tunnel. Their kitten bursts through the golden door and races home. Two new pins appear!"
    },
    {
      "beat": "Choice and CTA",
      "text": "A or B next? Comment and follow for the next map mystery!"
    }
  ],
